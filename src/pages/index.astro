<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Wireless Dataset Atlas</title>
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="https://wireless-dataset-atlas.vercel.app/en/" />
    <script is:inline>
      var l = (navigator.language || "en").toLowerCase().indexOf("zh") === 0 ? "zh" : "en";
      try { l = localStorage.getItem("atlas-lang") || l; } catch (e) {}
      location.replace("/" + l + "/" + location.search + location.hash);
    </script>
  </head>
  <body><a href="/en/">English</a> · <a href="/zh/">中文</a></body>
</html>
