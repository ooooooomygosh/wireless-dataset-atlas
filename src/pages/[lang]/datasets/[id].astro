---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import { allDatasets, paperOf, bibtex, taskById, tools, tutorials, t, label, labels, authorsShort, formatBands, LANGS, type Lang } from "../../../lib/data.ts";
import { specRows } from "../../../lib/view.ts";

export const getStaticPaths = (async () => {
  const ds = await allDatasets();
  return LANGS.flatMap((lang) => ds.map((d) => ({ params: { lang, id: d.id }, props: { d } })));
}) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const { d } = Astro.props;
const all = await allDatasets();
const paper = d.paper ? paperOf(d.paper) : null;
const byCites = (ids: string[]) => ids.map((id) => ({ id, p: paperOf(id) })).sort((a, b) => b.p.cited_by - a.p.cited_by);
const used = byCites(d.used_in);
const citing = byCites(d.citing);
const related = all
  .filter((x) => x.id !== d.id)
  .map((x) => ({ x, n: x.tasks.filter((k) => d.tasks.includes(k)).length }))
  .filter((r) => r.n > 0)
  .sort((a, b) => b.n - a.n || Math.abs(a.x.year - d.year) - Math.abs(b.x.year - d.year))
  .slice(0, 6)
  .map((r) => r.x);
const meta = (p: ReturnType<typeof paperOf>) => [authorsShort(p.authors), p.venue, p.year, p.cited_by ? t(lang, "papers.cited", { n: p.cited_by }) : ""].filter(Boolean).join(" · ");
const none = t(lang, "spec.none");
const rows = specRows(d, lang).filter(([, , v]) => v !== none);
const myTools = tools.filter((x) => d.tools.includes(x.id));
const myTutorials = tutorials.filter((x) => d.tutorials.includes(x.id));
const paras = (s: string) => s.split(/\n{2,}/).filter(Boolean);
const lines = (s: string) => s.split("\n").filter(Boolean);
const latest = d.versions[0];
const capGroups = ["data", "scenario", "propagation"].map((g) => ({
  g,
  items: d.capabilities.filter((c) => labels.capability[c.key]?.group === g && c.status !== "unknown" && c.status !== "none"),
})).filter((x) => x.items.length > 0);
const capUnknown = d.capabilities.filter((c) => c.status === "unknown");
const capNone = d.capabilities.filter((c) => c.status === "none");
const hasPipeline = !!d.pipeline || d.provenance.length > 0;
const hasNotes = d.technical_notes.length + d.limitations.length + d.usage.length > 0;
const hasPapers = !!paper || d.paper_summary.length > 0 || used.length + citing.length > 0 || d.materials.length + myTools.length + myTutorials.length > 0;
const tabs = [
  ["overview", "tab.overview"],
  hasPipeline && ["pipeline", "tab.pipeline"],
  ["spec", "tab.spec"],
  (d.versions.length > 0 || d.history.length > 0) && ["versions", "tab.versions"],
  hasNotes && ["notes", "tab.notes"],
  ["papers", "tab.papers"],
].filter(Boolean) as [string, string][];
const key: [string, string][] = [
  latest ? [t(lang, "detail.latest"), `${latest.version}${latest.date ? ` · ${latest.date}` : ""}`] : [t(lang, "spec.year"), String(d.year)],
  [t(lang, "spec.origin"), label(labels.origin, d.origin, lang)],
  [t(lang, "spec.band"), d.bands_ghz.length ? `${formatBands(d.bands_ghz)} ${t(lang, "unit.ghz")}` : ""],
  [t(lang, "spec.size"), d.size_gb ? `${d.size_gb} ${t(lang, "unit.gb")}` : ""],
  [t(lang, "spec.license"), d.license],
  [t(lang, "spec.access"), label(labels.access, d.access.type, lang)],
].filter(([, v]) => v) as [string, string][];
const ld = { "@context": "https://schema.org", "@type": "Dataset", name: d.name, description: d.summary.en, url: d.access.url, license: d.license, datePublished: String(d.year), keywords: d.tasks.join(", ") };
---
<Base lang={lang} nav="datasets" title={d.name} description={d.summary[lang]}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="crumb"><a href={`/${lang}/datasets/`}>{t(lang, "nav.datasets")}</a></div>
  <div class="detail-head">
    <div>
      <h1>{d.name}</h1>
      <div class="tags" style="margin-top:10px">
        <span class="tag"><i class={`dot ${d.origin}`}></i>{label(labels.origin, d.origin, lang)}</span>
        {d.signals.map((s) => <a class="tag" href={`/${lang}/datasets/?signal=${s}`}>{label(labels.signal, s, lang)}</a>)}
      </div>
      <div class="tags" style="margin-top:8px">
        {d.tasks.map((k) => <a class="tag" href={`/${lang}/tasks/${k}/`}>{taskById(k).name[lang]}</a>)}
      </div>
      <p class="lead">{d.summary[lang]}</p>
    </div>
    <div class="actions">
      <a class="btn primary" href={d.access.url} rel="noopener">{t(lang, "detail.download")} ↗</a>
      {paper && <a class="btn" href={paper.url} rel="noopener">{t(lang, "detail.paper")} ↗</a>}
      {d.code[0] && <a class="btn" href={d.code[0]} rel="noopener">{t(lang, "detail.code")} ↗</a>}
      <button class="btn" type="button" id="cmp" data-id={d.id}>{t(lang, "compare.add")}</button>
    </div>
  </div>

  <dl class="keyfacts">
    {key.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
  </dl>

  <nav class="tabs" role="tablist" aria-label={d.name}>
    {tabs.map(([id, k], i) => <a role="tab" href={`#${id}`} data-tab={id} aria-selected={i === 0 ? "true" : "false"}>{t(lang, k)}</a>)}
  </nav>

  <div class="detail-grid">
    <div class="detail-main" id="panels">
      <section id="overview" class="panel">
        {d.overview ? paras(d.overview[lang]).map((p) => <p class="body">{p}</p>) : <p class="body">{d.summary[lang]}</p>}
        {capGroups.length > 0 && (
          <>
            <h2 class="h2">{t(lang, "detail.support")}</h2>
            <p class="faint small" style="margin:-6px 0 12px">{t(lang, "detail.supportLegend")}</p>
            {capGroups.map(({ g, items }) => (
              <div class="capgroup">
                <h3 class="sub">{labels.capGroup[g][lang]}</h3>
                <ul class="caps">
                  {items.map((c) => (
                    <li class={`cap ${c.status}`} title={c.note?.[lang] ?? ""}>
                      <i class="capmark" aria-hidden="true"></i>
                      <span class="capname">{labels.capability[c.key][lang]}</span>
                      <span class="capstat">{labels.support[c.status][lang]}</span>
                      {c.note && <span class="capnote">{c.note[lang]}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            {capNone.length > 0 && (
              <details class="io-box" style="margin-top:8px">
                <summary>{labels.support.none[lang]} ({capNone.length})</summary>
                <ul class="plain">{capNone.map((c) => <li><b>{labels.capability[c.key][lang]}</b>{c.note ? ` — ${c.note[lang]}` : ""}</li>)}</ul>
              </details>
            )}
            {capUnknown.length > 0 && (
              <details class="io-box" style="margin-top:8px">
                <summary>{t(lang, "detail.notStated")} ({capUnknown.length})</summary>
                <p class="faint small">{capUnknown.map((c) => labels.capability[c.key][lang]).join(" · ")}</p>
              </details>
            )}
          </>
        )}
        {d.signal_details.length > 0 && (
          <>
            <h2 class="h2">{t(lang, "detail.modalities")}</h2>
            <div class="modal-grid">
              {d.signal_details.map((s) => (
                <div class="modal">
                  <div class="modal-h"><a href={`/${lang}/datasets/?signal=${s.signal}`}>{label(labels.signal, s.signal, lang)}</a></div>
                  <p>{s.text[lang]}</p>
                </div>
              ))}
            </div>
          </>
        )}
      </section>

      {hasPipeline && (
        <section id="pipeline" class="panel">
          {d.pipeline?.summary && <p class="body">{d.pipeline.summary[lang]}</p>}
          {d.pipeline?.scope && <p class="body faint">{d.pipeline.scope[lang]}</p>}
          {d.provenance.length > 0 && (
            <>
              <h3 class="sub">{t(lang, "detail.provenance")}</h3>
              <ol class="chain">{d.provenance.map((x) => <li>{x[lang]}</li>)}</ol>
            </>
          )}
          {d.pipeline && (
            <>
              <h3 class="sub">{t(lang, "detail.flow")}</h3>
              <ol class="flow">{d.pipeline.stages.map((s, i) => <li><a href={`#stage-${i + 1}`}><b>{i + 1}</b>{s.title[lang]}</a></li>)}</ol>
              <ol class="stages">
                {d.pipeline.stages.map((s, i) => (
                  <li class="stage" id={`stage-${i + 1}`}>
                    <div class="stage-n">{i + 1}</div>
                    <div class="stage-b">
                      <h3>{s.title[lang]}</h3>
                      <p>{s.detail[lang]}</p>
                      {(s.inputs || s.outputs || s.controls || s.checks) && (
                        <details class="io-box">
                          <summary>{t(lang, "detail.stageDetails")}</summary>
                          <div class="io">
                            {s.inputs && <div><b>{t(lang, "detail.inputs")}</b><ul>{s.inputs.map((x) => <li>{x[lang]}</li>)}</ul></div>}
                            {s.outputs && <div><b>{t(lang, "detail.outputs")}</b><ul>{s.outputs.map((x) => <li>{x[lang]}</li>)}</ul></div>}
                            {s.controls && <div><b>{t(lang, "detail.controls")}</b><ul>{s.controls.map((x) => <li>{x[lang]}</li>)}</ul></div>}
                            {s.checks && <div><b>{t(lang, "detail.checks")}</b><ul>{s.checks.map((x) => <li>{x[lang]}</li>)}</ul></div>}
                          </div>
                        </details>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </>
          )}
          {d.facts.length > 0 && (
            <>
              <h2 class="h2">{t(lang, "detail.howProduced")}</h2>
              <div class="acc">
                {d.facts.map((f) => (
                  <details>
                    <summary>{f.label[lang]}</summary>
                    <ul class="plain">{lines(f.text[lang]).map((x) => <li>{x.replace(/^•\s*/, "")}</li>)}</ul>
                  </details>
                ))}
              </div>
            </>
          )}
        </section>
      )}

      <section id="spec" class="panel">
        <dl class="spec">
          {rows.map(([, k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
          {d.aliases.length > 0 && (<><dt>{t(lang, "spec.aliases")}</dt><dd>{d.aliases.join(", ")}</dd></>)}
        </dl>
        <p class="faint small">{t(lang, "detail.checked")} {d.checked}</p>
        {d.variants.length > 0 && (
          <>
            <h2 class="h2">{t(lang, "detail.variants")}</h2>
            <div class="table-wrap"><table>
              <thead><tr><th>{t(lang, "detail.variants")}</th><th>{t(lang, "spec.signals")}</th><th>CSI</th></tr></thead>
              <tbody>{d.variants.map((v) => <tr><td><b>{v.name[lang]}</b></td><td>{v.observations[lang]}</td><td>{v.csi?.[lang] ?? ""}</td></tr>)}</tbody>
            </table></div>
          </>
        )}
        {d.field_notes.length > 0 && (
          <>
            <h2 class="h2">{t(lang, "detail.fieldNotes")}</h2>
            <dl class="facts">{d.field_notes.map((f) => (<><dt>{f.label[lang]}</dt><dd>{f.text[lang]}</dd></>))}</dl>
          </>
        )}
      </section>

      {(d.versions.length > 0 || d.history.length > 0) && (
        <section id="versions" class="panel">
          {d.versions.length > 0 ? (
            <ol class="timeline">
              {d.versions.map((v, i) => (
                <li class={i === 0 ? "now" : ""}>
                  <div class="tl-h"><b>{v.version}</b>{v.date && <span class="faint">{v.date}</span>}{i === 0 && <span class="tag">{t(lang, "detail.latest")}</span>}</div>
                  <p>{v.summary[lang]}{v.url && <> <a href={v.url} rel="noopener">{t(lang, "detail.sourceLink")} ↗</a></>}</p>
                </li>
              ))}
            </ol>
          ) : (
            <ul class="plain">{d.history.map((x) => <li>{x[lang]}</li>)}</ul>
          )}
        </section>
      )}

      {hasNotes && (
        <section id="notes" class="panel">
          {d.usage.length > 0 && (<><h2 class="h2 first">{t(lang, "detail.usage")}</h2><ol class="plain">{d.usage.map((x) => <li>{x[lang]}</li>)}</ol></>)}
          {d.limitations.length > 0 && (<><h2 class="h2">{t(lang, "detail.limitations")}</h2><ul class="plain">{d.limitations.map((x) => <li>{x[lang]}</li>)}</ul></>)}
          {d.technical_notes.length > 0 && (<><h2 class="h2">{t(lang, "detail.techNotes")}</h2><ul class="plain">{d.technical_notes.map((x) => <li>{x[lang]}</li>)}</ul></>)}
        </section>
      )}

      <section id="papers" class="panel">
        {paper && d.paper && (
          <>
            <h2 class="h2 first">{t(lang, "detail.datasetPaper")}</h2>
            <div class="paper-item">
              <a class="t" href={paper.url} rel="noopener">{paper.title}</a>
              <div class="m">{meta(paper)}</div>
              <div class="row" style="margin-top:8px">
                <button class="btn" type="button" id="bib" data-bib={bibtex(d.paper)} data-done={t(lang, "detail.copied")}>{t(lang, "detail.bibtex")}</button>
              </div>
            </div>
          </>
        )}
        {d.paper_summary.length > 0 && (
          <div class="acc" style="margin-top:12px">
            <details>
              <summary>{t(lang, "detail.paperSummary")}</summary>
              <dl class="facts">{d.paper_summary.map((f) => (<><dt>{f.label[lang]}</dt><dd>{f.text[lang]}</dd></>))}</dl>
            </details>
          </div>
        )}
        {used.length > 0 && (
          <>
            <h2 class="h2">{t(lang, "detail.usedIn")}</h2>
            <p class="faint small" style="margin:-6px 0 8px">{t(lang, "detail.usedInNote")}</p>
            {used.map(({ p }) => (<div class="paper-item"><a class="t" href={p.url} rel="noopener">{p.title}</a><div class="m">{meta(p)}</div></div>))}
          </>
        )}
        {citing.length > 0 && (
          <>
            <h2 class="h2">{t(lang, "detail.citing")}</h2>
            <p class="faint small" style="margin:-6px 0 8px">{t(lang, "detail.citingNote")}</p>
            {citing.map(({ p }) => (<div class="paper-item"><a class="t" href={p.url} rel="noopener">{p.title}</a><div class="m">{meta(p)}</div></div>))}
          </>
        )}
        {used.length === 0 && citing.length === 0 && (<><h2 class="h2">{t(lang, "detail.usedIn")}</h2><p class="faint">{t(lang, "detail.noUsedIn")}</p></>)}
        {d.materials.length > 0 && (
          <>
            <h2 class="h2">{t(lang, "detail.materials")}</h2>
            <ul class="plain">{d.materials.map((m) => <li><a href={m.path}>{m.title}</a> <span class="faint">· {m.license} · <a href={m.source_url} rel="noopener">{t(lang, "detail.localCopy")} ↗</a></span></li>)}</ul>
          </>
        )}
        {myTutorials.length > 0 && (
          <>
            <h2 class="h2">{t(lang, "detail.tutorials")}</h2>
            <ul class="plain">{myTutorials.map((x) => <li><a href={`/${lang}/tools/#tut-${x.id}`}>{x.title[lang]}</a></li>)}</ul>
          </>
        )}
        {myTools.length > 0 && (
          <>
            <h2 class="h2">{t(lang, "detail.tools")}</h2>
            <ul class="plain">{myTools.map((x) => <li><a href={`/${lang}/tools/#${x.id}`}>{x.name}</a> <span class="faint">· {x.category[lang]}</span></li>)}</ul>
          </>
        )}
      </section>
    </div>

    <aside class="detail-side">
      <h2 style="margin:0 0 10px">{t(lang, "detail.related")}</h2>
      <ul class="side-list">
        {related.map((x) => <li><a href={`/${lang}/datasets/${x.id}/`}>{x.name}</a><div class="sub">{x.year} · {label(labels.origin, x.origin, lang)}</div></li>)}
      </ul>
    </aside>
  </div>
  <script>
    import { getIds, toggle } from "../../../scripts/compare-store.ts";
    const b = document.getElementById("cmp") as HTMLButtonElement;
    const lang = document.body.dataset.lang;
    const add = lang === "zh" ? "加入对比" : "Add to comparison", rem = lang === "zh" ? "移出对比" : "Remove from comparison";
    const sync = () => { b.textContent = getIds().includes(b.dataset.id!) ? rem : add; };
    b.addEventListener("click", () => { toggle(b.dataset.id!); sync(); });
    window.addEventListener("compare-change", sync); sync();
    const bib = document.getElementById("bib") as HTMLButtonElement | null;
    bib?.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(bib.dataset.bib!); const o = bib.textContent; bib.textContent = bib.dataset.done!; setTimeout(() => (bib.textContent = o), 1400); } catch {}
    });

    // tabs: show one panel at a time, keep the hash in sync, work without JS as a stacked page
    const panels = document.getElementById("panels")!;
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>(".tabs [data-tab]")];
    const ids = tabs.map((a) => a.dataset.tab!);
    panels.classList.add("js");
    function show(id: string, push = false) {
      if (!ids.includes(id)) id = ids[0];
      panels.querySelectorAll<HTMLElement>(".panel").forEach((p) => (p.hidden = p.id !== id));
      tabs.forEach((a) => a.setAttribute("aria-selected", String(a.dataset.tab === id)));
      if (push) history.replaceState(null, "", "#" + id);
    }
    function fromHash() {
      const h = decodeURIComponent(location.hash.slice(1));
      const stage = h.startsWith("stage-");
      show(stage ? "pipeline" : h);
      if (stage) document.getElementById(h)?.scrollIntoView({ block: "start" });
    }
    tabs.forEach((a, i) => {
      a.addEventListener("click", (e) => { e.preventDefault(); show(a.dataset.tab!, true); });
      a.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        const n = tabs[(i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length];
        n.focus(); show(n.dataset.tab!, true);
      });
    });
    window.addEventListener("hashchange", fromHash);
    fromHash();
  </script>
</Base>
