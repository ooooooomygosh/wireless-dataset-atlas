---
import type { Dataset } from "../schema.ts";
import { SIGNAL } from "../i18n/enums.ts";
import { t, tasks, type Lang } from "../lib/data.ts";
interface Props { lang: Lang; datasets: Dataset[] }
const { lang, datasets } = Astro.props;
const sigs = Object.keys(SIGNAL).filter((s) => datasets.some((d) => d.signals.includes(s as never)));
const rows = tasks.filter((x) => datasets.some((d) => d.tasks.includes(x.id)));
const cell = 30, L = 210, T = 128;
const W = L + sigs.length * cell + 96, H = T + rows.length * cell + 6;
const n = (tid: string, s: string) => datasets.filter((d) => d.tasks.includes(tid) && d.signals.includes(s as never)).length;
const max = Math.max(1, ...rows.flatMap((r) => sigs.map((s) => n(r.id, s))));
---
<div class="chart">
  <h3>{t(lang, "chart.matrix.title")}</h3>
  <p class="note">{t(lang, "chart.matrix.note")}</p>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t(lang, "chart.matrix.title")} style={`min-width:${Math.min(W, 640)}px`}>
    {sigs.map((s, j) => <text transform={`translate(${L + j * cell + cell / 2 + 4},${T - 8}) rotate(-50)`} text-anchor="start">{SIGNAL[s][lang]}</text>)}
    {rows.map((r, i) => (
      <g>
        <a href={`/${lang}/tasks/${r.id}/`}><text x={L - 10} y={T + i * cell + cell / 2 + 4} text-anchor="end">{r.name[lang]}</text></a>
        {sigs.map((s, j) => {
          const c = n(r.id, s);
          return (
            <a href={c ? `/${lang}/datasets/?task=${r.id}&signal=${s}` : undefined}>
              <title>{r.name[lang]} × {SIGNAL[s][lang]}: {c}</title>
              <rect x={L + j * cell + 1} y={T + i * cell + 1} width={cell - 2} height={cell - 2} rx="3" fill={c ? "var(--accent)" : "var(--bg-subtle)"} fill-opacity={c ? 0.14 + 0.7 * (c / max) : 1} />
              {c > 0 && <text x={L + j * cell + cell / 2} y={T + i * cell + cell / 2 + 4} text-anchor="middle" style={`fill:${c / max > 0.55 ? "#fff" : "var(--ink)"}`}>{c}</text>}
            </a>
          );
        })}
      </g>
    ))}
  </svg>
</div>
