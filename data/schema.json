{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wireless Dataset Atlas",
  "type": "object",
  "required": [
    "resources",
    "sources",
    "topics",
    "tutorials",
    "qa"
  ],
  "properties": {
    "resources": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "origin",
          "summary",
          "fields",
          "tasks",
          "sourceIds",
          "productionPipeline"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "直接提供",
                "可计算",
                "需额外仿真",
                "不支持",
                "未知"
              ]
            }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "status",
                "reason"
              ]
            }
          },
          "scenarios": {
            "type": "array"
          },
          "pairing": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "simultaneous_measured",
                  "repeatable_trajectory",
                  "colocated_separate_campaign",
                  "simulated_shared_geometry",
                  "unconfirmed"
                ]
              },
              "frequenciesGHz": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "productionPipeline": {
            "type": "object",
            "required": [
              "scope",
              "summary",
              "stages",
              "nativeOutputs",
              "derivedOutputs",
              "reproductionNotes"
            ],
            "properties": {
              "scope": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "stages": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "inputs",
                    "operation",
                    "outputs",
                    "controls",
                    "checks",
                    "evidenceStatus",
                    "sourceIds"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "operation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "inputs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "outputs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "controls": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "checks": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "sourceIds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "evidenceStatus": {
                      "type": "string"
                    }
                  }
                }
              },
              "nativeOutputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "derivedOutputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reproductionNotes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "productionFacts": {
            "type": "object",
            "required": [
              "entryInput",
              "physicalModel",
              "channelFormation",
              "frequencyChange",
              "arrayChange",
              "timeMeaning",
              "blockageChange",
              "costDrivers",
              "artifacts",
              "commonMistake",
              "sourceIds"
            ],
            "properties": {
              "sourceIds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "title",
          "readScope",
          "status",
          "checkedAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "readScope": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "resourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "tutorials": {
      "type": "array",
      "minItems": 6
    },
    "qa": {
      "type": "array"
    },
    "researchPlaybooks": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "question",
          "candidates",
          "firstExperiment"
        ],
        "properties": {
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "resourceId",
                "role",
                "why",
                "whatCanProve",
                "whatCannotProve",
                "extraWork",
                "scope",
                "sourceIds"
              ]
            }
          }
        }
      }
    },
    "relatedProjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "officialRepo",
          "license",
          "pipelineRole",
          "howToUse",
          "limitations",
          "resourceIds",
          "sourceIds"
        ],
        "properties": {
          "officialRepo": {
            "type": "string",
            "pattern": "^https://"
          },
          "resourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "researchPapers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "year",
          "venue",
          "url",
          "resourceIds",
          "system",
          "predictionTarget",
          "decisionTarget",
          "protocol",
          "keyFinding",
          "remainingGap",
          "readScope",
          "sourceIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "resourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "officialMaterials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "resourceIds",
          "sourceUrl",
          "upstreamRef",
          "filePath",
          "license",
          "licenseUrl",
          "attribution",
          "readScope",
          "kind",
          "sourceIds"
        ],
        "properties": {
          "filePath": {
            "type": "string",
            "pattern": "^materials/official/"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "licenseUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "resourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
